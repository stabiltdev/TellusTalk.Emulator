<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The image, for both architectures, which restore must know of. The extra family carries time zone data, which
       reading a time as Europe/Stockholm needs; the plain chiseled image has none. -->
  <PropertyGroup>
    <RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers>
    <ContainerRepository>stabiltdev/tellustalk-emulator</ContainerRepository>
    <ContainerFamily>noble-chiseled-extra</ContainerFamily>
  </PropertyGroup>

  <ItemGroup>
    <ContainerPort Include="8080" Type="tcp" />
  </ItemGroup>

</Project>

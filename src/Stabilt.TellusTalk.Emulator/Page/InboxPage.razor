@* The page: the tabs over a list of messages, and the selected message beside it. The list and the detail live here
   rather than in components of their own, since a component's parameters are public and the message is not. *@
@inject MessageStore Store
@inject TimeProvider Time

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>TellusTalk Emulator</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script src="/js/theme.js"></script>
    <link rel="stylesheet" href="/css/app.css" />
    <script src="/js/app.js" defer></script>
</head>
<body>
<div class="tt">
    <TopBar Tab="@CurrentTab" Search="@SearchText" SentCount="@Store.Count(MessageState.Sent)" ScheduledCount="@Store.Count(MessageState.Scheduled)"
            BlockedCount="@Store.Count(MessageState.Blocked)" />
    <main class="tt-body">
        <nav id="list" class="tt-list" aria-label="Messages">
            @foreach (var message in _messages)
            {
                @Row(message)
            }
        </nav>
        <section id="detail" class="tt-detail" aria-label="The selected message">
            @if (_selected is null)
            {
                <p class="tt-empty">@EmptyText</p>
            }
            else
            {
                @Detail(_selected)
            }
        </section>
    </main>
</div>
</body>
</html>

@code {
    /// <summary>Fields an SMS's detail shows in a place of their own, so they are left out of the other fields.</summary>
    private static readonly HashSet<string> ShownFields = new(StringComparer.Ordinal)
    {
        "to", "text", "sms_header", "sms_originator_source", "sms_originator_text", "sms_originator_number",
        "sms_flash", "sms_validity_time", "billing_id", "echo", "report_to", "reply_to",
    };

    /// <summary>Another channel's detail shows the subject and the HTML in places of their own, and the SMS's not at all.</summary>
    private static readonly HashSet<string> PlainShownFields = new(ShownFields, StringComparer.Ordinal) { "subject", "html" };

    private IReadOnlyList<Message> _messages = [];
    private Message? _selected;

    /// <summary><c>sent</c>, the default, <c>scheduled</c> or <c>blocked</c>.</summary>
    [Parameter]
    public string? Tab { get; set; }

    [Parameter]
    public string? SelectedId { get; set; }

    [Parameter]
    public string? Search { get; set; }

    private string CurrentTab => Tab switch
    {
        "scheduled" => "scheduled",
        "blocked" => "blocked",
        _ => "sent",
    };

    private bool IsScheduled => CurrentTab == "scheduled";

    private string? SearchText => string.IsNullOrWhiteSpace(Search) ? null : Search;

    private string EmptyText =>
        SearchText is not null ? "No message matches the search."
        : CurrentTab == "scheduled" ? "Nothing is scheduled."
        : CurrentTab == "blocked" ? "Nothing is blocked."
        : "No messages yet. Send one to POST /send/v1 and it shows up here.";

    protected override void OnParametersSet()
    {
        var state = CurrentTab switch
        {
            "scheduled" => MessageState.Scheduled,
            "blocked" => MessageState.Blocked,
            _ => MessageState.Sent,
        };

        _messages = Store.List(state, search: SearchText);
        _selected = _messages.FirstOrDefault(message => string.Equals(message.Id, SelectedId, StringComparison.Ordinal))
                    ?? _messages.FirstOrDefault();
    }

    private RenderFragment Row(Message message) =>
        @<a class="tt-row @(message == _selected ? "sel" : null) @(message.Warnings.Count > 0 ? "warned" : null)"
            href="@Link(message)" data-id="@message.Id" data-at="@PageTime.Iso(message.ShownAt)">
            <span class="l1">
                <span class="num">@message.To.Address</span>
                <span class="time">@if (IsScheduled)
                    {
                        <text>Due </text>
                    }<time datetime="@PageTime.Iso(message.ShownAt)">@PageTime.Fallback(message.ShownAt)</time></span>
            </span>
            @if (message.Sms is { } sms)
            {
                <span class="from @(sms.Sender.Kind == SenderKind.Number ? "digits" : null)">@sms.Sender.Display</span>
                <span class="prev">@message.Text</span>
            }
            else
            {
                <span class="from">@ChannelLabel(message.To.Channel)</span>
                <span class="prev">@(message.Request.Subject is { Length: > 0 } subject ? subject : message.Text)</span>
            }
            @if (message.Warnings.Count > 0)
            {
                <span class="warn-mark" role="img" aria-label="@WarningCount(message)" title="@WarningCount(message)"></span>
            }
        </a>;

    private RenderFragment Detail(Message message) => message.Sms is { } sms ? SmsDetail(message, sms) : PlainDetail(message);

    private RenderFragment SmsDetail(Message message, SmsContent sms) =>
        @<div class="tt-message">
            <PhonePreview Sender="@sms.Sender.Display" Time="@message.ShownAt" Parts="@Segments(message.Text, sms.Parts)"
                          Note="@(message.BlockedReason is null ? null : "Not sent")" />
            <div class="tt-info">
                <h2 class="tt-title">To @message.To.Address</h2>
                <p class="tt-sub">From @sms.Sender.Display, shown as @(sms.Sender.Kind == SenderKind.Number ? "a number" : "a name").</p>
                @if (SenderNote(sms.Sender, message.Request.OriginatorSource) is { } note)
                {
                    <p class="tt-sub">@note</p>
                }
                @Times(message)
                @if (message.DuplicateOf is { } duplicateOf)
                {
                    @DuplicateLine(duplicateOf)
                }
                else if (message.BlockedReason is { } reason)
                {
                    var fault = NumberFault(reason);
                    <p class="tt-sub">Not sent: the number @fault.Text (<code>@fault.LogStatus</code>).</p>
                }
                @WarningList(message)
                <PartsBar Sizes="@Sizes(sms.Parts)" Left="@sms.Parts.LeftInLastPart" Length="@sms.Parts.Length"
                          MaxParts="@sms.MaxParts" CharacterSet="@CharacterSetName(sms.Parts.CharacterSet)" />
                <dl>
                    <dt>Job id</dt>
                    <dd>@message.JobId</dd>
                    <dt>Flash</dt>
                    <dd>@(Shown(message.Request.Body.SmsFlash) ?? "No")</dd>
                    <dt>Valid for</dt>
                    <dd>@(Shown(message.Request.Body.SmsValidityTime) is { } validity ? $"{validity} seconds" : "Operator default")</dd>
                    @RequestRows(message, ShownFields)
                </dl>
                @if (message.Request.ReportTo.Count > 0)
                {
                    @Reports(message)
                }
                @RequestAndDelete(message)
            </div>
        </div>;

    /// <summary>
    /// Without a phone, parts or reports, since how another channel arrives and how K8 reports it are unobserved. The
    /// HTML is shown as its source, never rendered.
    /// </summary>
    private static RenderFragment PlainDetail(Message message) =>
        @<div class="tt-message plain">
            <div class="tt-info">
                <h2 class="tt-title">@($"{ChannelLabel(message.To.Channel)} to {message.To.Address}")</h2>
                @Times(message)
                @WarningList(message)
                <dl>
                    @if (message.Request.Subject is { Length: > 0 } subject)
                    {
                        <dt>Subject</dt>
                        <dd>@subject</dd>
                    }
                    <dt>Text</dt>
                    <dd class="tt-text">@message.Text</dd>
                    @if (Shown(message.Request.Body.Html) is { } html)
                    {
                        <dt>HTML</dt>
                        <dd class="tt-text"><code>@html</code></dd>
                    }
                    <dt>Job id</dt>
                    <dd>@message.JobId</dd>
                    @RequestRows(message, PlainShownFields)
                </dl>
                @RequestAndDelete(message)
            </div>
        </div>;

    private static RenderFragment Times(Message message) =>
        @<p class="tt-sub">Received <time datetime="@PageTime.Iso(message.ReceivedAt)">@PageTime.Fallback(message.ReceivedAt)</time>.@if (message.DueAt is { } due)
            {
                <text> Due </text><time datetime="@PageTime.Iso(due)">@PageTime.Fallback(due)</time><text>.</text>
            }</p>;

    private static RenderFragment WarningList(Message message) =>
        @<text>@if (message.Warnings.Count > 0)
            {
                <ul class="tt-warnings" aria-label="Warnings">
                    @foreach (var warning in message.Warnings)
                    {
                        <li><code>@warning.Code</code> @warning.Text</li>
                    }
                </ul>
            }</text>;

    /// <summary>What the request sent beside the message itself, every channel alike.</summary>
    private static RenderFragment RequestRows(Message message, IReadOnlySet<string> shownFields) =>
        @<text>@if (Shown(message.Request.Body.BillingId) is { } billingId)
            {
                <dt>Billing id</dt>
                <dd>@billingId</dd>
            }
            @if (Shown(message.Request.Body.Echo) is { } echo)
            {
                <dt>Echo</dt>
                <dd><code>@echo</code></dd>
            }
            @if (message.Request.ReportTo.Count > 0)
            {
                <dt>Report to</dt>
                <dd>@Addresses(message.Request.ReportTo)</dd>
            }
            @if (message.Request.ReplyTo.Count > 0)
            {
                <dt>Reply to</dt>
                <dd>@Addresses(message.Request.ReplyTo)</dd>
            }
            @foreach (var field in OtherFields(message, shownFields))
            {
                <dt>@field.Key</dt>
                <dd><code>@field.Value</code></dd>
            }</text>;

    /// <summary>Both views are rendered and CSS shows the one whose button is checked, so the switch works without the script.</summary>
    private static RenderFragment RequestAndDelete(Message message) =>
        @<text><details class="tt-request">
                <summary>Show request</summary>
                <fieldset class="tt-views" aria-label="How the request is shown">
                    <input type="radio" id="request-readable" name="request-view" value="readable" checked />
                    <label for="request-readable">Readable</label>
                    <input type="radio" id="request-sent" name="request-view" value="sent" />
                    <label for="request-sent">As sent</label>
                </fieldset>
                <pre class="readable">@ReadableJson.Write(message.RawRequest)</pre>
                <pre class="sent">@message.RawRequest</pre>
            </details>
            <div class="tt-actions">
                <button type="button" class="tt-btn" data-delete="@message.Id">Delete</button>
            </div></text>;

    /// <summary>The live refresh swaps this section by its id, so a report sent shows up without leaving the message.</summary>
    private RenderFragment Reports(Message message) =>
        @<section id="reports" class="tt-reports" aria-labelledby="reports-title">
            <h3 id="reports-title">Delivery reports</h3>
            @if (Store.Reports(message.Id) is { Count: > 0 } attempts)
            {
                <ol>
                    @foreach (var attempt in attempts)
                    {
                        <li class="@(attempt.Sent ? null : "unsent")">
                            <span class="tt-status @(attempt.Status == ReportStatus.Failed ? "failed" : attempt.Status == ReportStatus.Blocked ? "blocked" : "delivered")">@(attempt.Status == ReportStatus.Failed ? "Failed" : attempt.Status == ReportStatus.Blocked ? "Blocked" : "Delivered")</span>
                            <code>@attempt.Target</code>
                            <span class="outcome">@attempt.Outcome</span>
                            <time datetime="@PageTime.Iso(attempt.At)">@PageTime.Fallback(attempt.At)</time>
                            @if (attempt.FailedReason is { } failedReason)
                            {
                                <span class="failed-reason">TellusTalk logs it failed: @failedReason</span>
                            }
                        </li>
                    }
                </ol>
            }
            else
            {
                <p class="tt-sub">None yet.</p>
            }
            <div class="tt-actions">
                <button type="button" class="tt-btn" data-report="delivered" data-id="@message.Id">Send delivered report</button>
                <button type="button" class="tt-btn" data-report="failed" data-id="@message.Id">Send failed report</button>
            </div>
        </section>;

    /// <summary>Header values are masked: a report address may carry credentials for the app that receives reports.</summary>
    private static RenderFragment Addresses(IReadOnlyList<ReportAddress> addresses) =>
        @<ul class="tt-addresses">
            @foreach (var address in addresses)
            {
                @* Blazor drops literal whitespace next to a code block, so each setting writes its space as an expression. *@
                <li>
                    <code>@address.Target</code>
                    @if (address.ContentType is { } contentType)
                    {
                        <text>@(" ")<span class="tt-setting">as @contentType</span></text>
                    }
                    @foreach (var header in address.Headers)
                    {
                        <text>@(" ")<span class="tt-setting">@header.Key: ••••••</span></text>
                    }
                </li>
            }
        </ul>;

    private static (string Text, string LogStatus) NumberFault(BlockedReason reason) => reason switch
    {
        BlockedReason.NumberNotNumeric => ("is not numeric", "txtNUMBER_NOT_NUMERIC"),
        BlockedReason.NotANumber => ("is a + alone", "txtNOT_A_NUMBER"),
        BlockedReason.MissingAddress => ("is empty", "txtMISSING_ADDRESS"),
        _ => throw new InvalidOperationException($"The blocked reason '{reason}' is no fault of the number."),
    };

    /// <summary>The original may be scheduled, trimmed by the retention limit or deleted, so the link goes to the tab that lists it, if any.</summary>
    private RenderFragment DuplicateLine(string originalId) =>
        Store.Find(originalId) is { } original
            ? @<p class="tt-sub">Held back as a duplicate of <a href="/?tab=@(original.StateAt(Time.GetUtcNow()) == MessageState.Scheduled ? "scheduled" : "sent")&id=@original.Id">@original.Id</a> (received <time datetime="@PageTime.Iso(original.ReceivedAt)">@PageTime.Fallback(original.ReceivedAt)</time>).</p>
            : @<p class="tt-sub">Held back as a duplicate of @originalId.</p>;

    private string Link(Message message) =>
        SearchText is null
            ? $"/?tab={CurrentTab}&id={message.Id}"
            : $"/?tab={CurrentTab}&id={message.Id}&q={Uri.EscapeDataString(SearchText)}";

    private static string WarningCount(Message message) =>
        message.Warnings.Count == 1 ? "1 warning" : $"{message.Warnings.Count} warnings";

    private static string? SenderNote(ShownSender sender, string? originatorSource) => (sender, originatorSource) switch
    {
        ({ Source: "account" }, _) => "The request has no sender field, so the user's Sender setting decides.",
        ({ Source: "replysms" }, _) => "The request asked for replysms, so the reply number is shown.",
        ({ FromAccount: true, Source: var source }, _) => $"The request named no source and {FieldName(source)} is empty, so the reply number is shown.",
        ({ Source: var source }, null) => $"The request named no source, so TellusTalk chose {FieldName(source)}.",
        _ => null,
    };

    private static string FieldName(string source) => source switch
    {
        "text" => "sms_originator_text",
        "number" => "sms_originator_number",
        _ => source,
    };

    /// <summary>The text split where each part begins; binary content is no text a phone shows.</summary>
    private static IReadOnlyList<string> Segments(string text, SmsParts parts)
    {
        if (parts.CharacterSet == SmsCharacterSet.Binary)
        {
            return [$"Binary message, {parts.Length} bytes"];
        }

        var starts = parts.Starts;

        return starts
            .Select((start, index) => text[start..(index + 1 < starts.Count ? starts[index + 1] : text.Length)])
            .ToList();
    }

    /// <summary>Every part but the last is drawn full; the last holds what the text uses of it.</summary>
    private static IReadOnlyList<int> Sizes(SmsParts parts)
    {
        var capacity = parts.Count == 1
            ? parts.Length + parts.LeftInLastPart
            : SmsPartsCalculator.SplitPartCapacity(parts.CharacterSet);

        return Enumerable
            .Repeat(capacity, parts.Count - 1)
            .Append(capacity - parts.LeftInLastPart)
            .ToList();
    }

    private static string CharacterSetName(SmsCharacterSet characterSet) => characterSet switch
    {
        SmsCharacterSet.Gsm => "gsm",
        SmsCharacterSet.Ucs2 => "ucs2",
        _ => "binary",
    };

    private static IEnumerable<KeyValuePair<string, string?>> OtherFields(Message message, IReadOnlySet<string> shownFields) =>
        message.Request.Fields
            .Where(field => !shownFields.Contains(field.Key))
            .Select(field => KeyValuePair.Create(field.Key, Shown(field.Value)));

    /// <summary>An SMS is shown by its sender instead.</summary>
    private static string ChannelLabel(MessageChannel channel) => channel switch
    {
        MessageChannel.Email => "E-mail",
        MessageChannel.Fax => "Fax",
        MessageChannel.Mms => "MMS",
        MessageChannel.Voice => "Voice",
        MessageChannel.Group => "Group",
        _ => throw new InvalidOperationException($"The channel '{channel}' has no label."),
    };

    private static string? Shown(JsonElement value) => value.ValueKind switch
    {
        JsonValueKind.Null or JsonValueKind.Undefined => null,
        JsonValueKind.String => value.GetString(),
        _ => value.GetRawText(),
    };
}
